# === Backend (Lovable Cloud — se rellenan automáticamente) ===
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# === Mercado Pago (FRONTEND — sólo claves PÚBLICAS) ===
# Modo activo del frontend: "test" o "production".
# Debe coincidir con MP_MODE del backend.
VITE_MP_MODE="test"

# Public Key de Mercado Pago (empieza con APP_USR-... o TEST-...).
# En Hostinger se define como variable de entorno del build o se hornea aquí
# antes de subir la carpeta dist.
VITE_MP_PUBLIC_KEY=""
